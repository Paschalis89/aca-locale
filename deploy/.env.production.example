# ============================================================
# ACA Locale - production environment
# Copy to deploy/.env.production on the server.
# Never commit deploy/.env.production.
# ============================================================

APP_DOMAIN=locale.amalficoastartistry.com
LETSENCRYPT_EMAIL=REPLACE_WITH_OPERATIONS_EMAIL

# ------------------------------------------------------------
# PostgreSQL
# Use long random values in production.
# ------------------------------------------------------------
POSTGRES_DB=aca_locale
POSTGRES_USER=aca_locale
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# ------------------------------------------------------------
# React Router / Shopify
# ------------------------------------------------------------
SHOPIFY_API_KEY=REPLACE_WITH_PRODUCTION_CLIENT_ID
SHOPIFY_API_SECRET=REPLACE_WITH_PRODUCTION_CLIENT_SECRET
SHOPIFY_APP_URL=https://locale.amalficoastartistry.com
SHOPIFY_APP_DISTRIBUTION=single_merchant
SHOPIFY_SESSION_DATABASE_URL=file:/data/shopify-session.sqlite
SCOPES=read_content,read_locales,read_markets,read_metaobject_definitions,read_metaobjects,read_products,read_translations,write_translations
SHOP_CUSTOM_DOMAIN=

# Same value must be used by React Router and NestJS.
# Generate for example with: openssl rand -hex 32
ACA_LOCALE_INTERNAL_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS

# ------------------------------------------------------------
# NestJS backend
# ------------------------------------------------------------
API_PREFIX=api/v1
HEALTHCHECK_TIMEOUT_MS=2500
ENABLE_DEMO_ENDPOINTS=false
ENABLE_SWAGGER=false

# ------------------------------------------------------------
# Queue / recovery
# ------------------------------------------------------------
TRANSLATION_QUEUE_PREFIX=aca-locale
TRANSLATION_QUEUE_CONCURRENCY=2
TRANSLATION_QUEUE_PER_SHOP_CONCURRENCY=1
TRANSLATION_QUEUE_ATTEMPTS=5
TRANSLATION_QUEUE_REVIEW_ATTEMPTS=5
TRANSLATION_QUEUE_PUBLISH_ATTEMPTS=8
TRANSLATION_QUEUE_BACKOFF_MS=10000
TRANSLATION_QUEUE_RATE_LIMIT_MAX=10
TRANSLATION_QUEUE_RATE_LIMIT_DURATION_MS=1000
TRANSLATION_QUEUE_RECOVERY_INTERVAL_MS=60000
TRANSLATION_QUEUE_STALE_RUNNING_MS=300000
TRANSLATION_QUEUE_RECOVERY_BATCH_SIZE=100

# ------------------------------------------------------------
# AI / translation providers
# Keep unused provider keys blank.
# ------------------------------------------------------------
AI_TRANSLATION_MODEL=
AI_REVIEW_MODEL=
AI_FALLBACK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPL_API_KEY=
DEEPL_API_URL=https://api.deepl.com
