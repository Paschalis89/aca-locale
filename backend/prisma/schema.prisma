generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  UNINSTALLED
  SUSPENDED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

model Shop {
  id String @id @default(cuid())

  shopifyDomain String  @unique
  shopifyShopId String? @unique

  name String?

  status ShopStatus @default(ACTIVE)

  sourceLocale String?

  currencyCode String?
  ianaTimezone String?

  primaryDomainHost String?
  primaryDomainUrl  String?

  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        ShopSettings?
  aiConfiguration AiConfiguration?

  languages ShopLanguage[]
  markets   ShopMarket[]

  @@index([status])
}

model ShopSettings {
  id String @id @default(cuid())

  shopId String @unique

  autoTranslate      Boolean @default(false)
  autoPublish        Boolean @default(false)
  requireHumanReview Boolean @default(true)
  enableAiReview     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model AiConfiguration {
  id String @id @default(cuid())

  shopId String @unique

  translationProvider AiProvider @default(OPENAI)
  translationModel    String?

  reviewProvider AiProvider @default(OPENAI)
  reviewModel    String?

  fallbackProvider AiProvider @default(OPENAI)
  fallbackModel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Language {
  id String @id @default(cuid())

  locale String @unique
  name   String

  shops ShopLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopLanguage {
  id String @id @default(cuid())

  shopId     String
  languageId String

  primary   Boolean @default(false)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([shopId, languageId])
  @@index([shopId])
  @@index([languageId])
}

model ShopMarket {
  id String @id @default(cuid())

  shopId String

  shopifyMarketId String

  name   String
  handle String

  status String
  type   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyMarketId])
  @@unique([shopId, handle])
  @@index([shopId])
  @@index([status])
}
