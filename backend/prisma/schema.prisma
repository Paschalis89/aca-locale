generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  UNINSTALLED
  SUSPENDED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

enum TranslationProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  DEEPL
}

enum TranslationStateStatus {
  EMPTY_SOURCE
  MISSING
  TRANSLATED
  OUTDATED
}

enum TranslationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum TranslationJobItemStatus {
  PENDING
  GENERATING
  GENERATED
  VALIDATED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  FAILED
}

model Shop {
  id String @id @default(cuid())

  shopifyDomain String  @unique
  shopifyShopId String? @unique

  name String?

  status ShopStatus @default(ACTIVE)

  sourceLocale String?

  currencyCode String?
  ianaTimezone String?

  primaryDomainHost String?
  primaryDomainUrl  String?

  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        ShopSettings?
  aiConfiguration AiConfiguration?

  languages ShopLanguage[]
  markets   ShopMarket[]

  translationResources TranslationResource[]
  translationJobs      TranslationJob[]

  @@index([status])
}

model ShopSettings {
  id String @id @default(cuid())

  shopId String @unique

  autoTranslate      Boolean @default(false)
  autoPublish        Boolean @default(false)
  requireHumanReview Boolean @default(true)
  enableAiReview     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model AiConfiguration {
  id String @id @default(cuid())

  shopId String @unique

  translationProvider TranslationProvider @default(OPENAI)
  translationModel    String?

  reviewProvider AiProvider @default(OPENAI)
  reviewModel    String?

  fallbackProvider TranslationProvider @default(OPENAI)
  fallbackModel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Language {
  id String @id @default(cuid())

  locale String @unique
  name   String

  shops ShopLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopLanguage {
  id String @id @default(cuid())

  shopId     String
  languageId String

  primary   Boolean @default(false)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([shopId, languageId])
  @@index([shopId])
  @@index([languageId])
}

model ShopMarket {
  id String @id @default(cuid())

  shopId String

  shopifyMarketId String

  name   String
  handle String

  status String
  type   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyMarketId])
  @@unique([shopId, handle])
  @@index([shopId])
  @@index([status])
}

model TranslationResource {
  id String @id @default(cuid())

  shopId String

  shopifyResourceId String
  resourceType      String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  fields TranslationField[]

  @@unique([shopId, resourceType, shopifyResourceId])
  @@index([shopId, resourceType])
}

model TranslationField {
  id String @id @default(cuid())

  resourceId String

  key  String
  type String

  sourceLocale String
  sourceValue  String @db.Text
  sourceDigest String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource TranslationResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  states   TranslationState[]
  jobItems TranslationJobItem[]

  @@unique([resourceId, key])
  @@index([resourceId])
}

model TranslationState {
  id String @id @default(cuid())

  fieldId String

  targetLocale String

  status TranslationStateStatus

  translatedValue      String?   @db.Text
  translationUpdatedAt DateTime?

  scannedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field TranslationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, targetLocale])
  @@index([targetLocale, status])
}

model TranslationJob {
  id String @id @default(cuid())

  shopId String

  sourceLocale String
  targetLocale String

  status TranslationJobStatus @default(QUEUED)

  provider TranslationProvider?
  model    String?

  fallbackProvider TranslationProvider?
  fallbackModel    String?

  reviewProvider AiProvider?
  reviewModel    String?

  totalItems     Int @default(0)
  completedItems Int @default(0)
  failedItems    Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  items TranslationJobItem[]

  @@index([shopId, status])
  @@index([shopId, targetLocale])
  @@index([createdAt])
}

model TranslationJobItem {
  id String @id @default(cuid())

  jobId   String
  fieldId String

  fallbackUsed        Boolean @default(false)
  primaryErrorMessage String? @db.Text

  sourceDigest String
  sourceValue  String @db.Text

  translatedValue String? @db.Text

  status TranslationJobItemStatus @default(PENDING)

  provider TranslationProvider?
  model    String?

  generatedAt DateTime?
  validatedAt DateTime?

  validationPassed Boolean?

  validationErrors   Int @default(0)
  validationWarnings Int @default(0)

  validationIssues Json?

  validationVersion String?

  approvedAt    DateTime?
  approvedValue String?   @db.Text

  humanReviewedAt DateTime?
  humanReviewNote String?   @db.Text

  publishedAt DateTime?

  aiReviewedAt DateTime?

  aiReviewPassed Boolean?
  aiReviewScore  Int?

  aiReviewIssues Json?

  aiReviewSuggestedTranslation String? @db.Text
  aiReviewErrorMessage         String? @db.Text

  aiReviewProvider AiProvider?
  aiReviewModel    String?

  /**
   * Regeneration audit chain.
   * A regenerated translation is a NEW
   * job item. The previous item is never
   * overwritten.
   */
  regeneratedFromItemId String?

  regeneratedFromItem TranslationJobItem?  @relation("TranslationItemRegeneration", fields: [regeneratedFromItemId], references: [id], onDelete: SetNull)
  regeneratedItems    TranslationJobItem[] @relation("TranslationItemRegeneration")

  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job TranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  field TranslationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([jobId, fieldId])
  @@index([jobId, status])
  @@index([fieldId])
  @@index([regeneratedFromItemId])
}
