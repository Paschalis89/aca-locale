generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  UNINSTALLED
  SUSPENDED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

enum TranslationProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  DEEPL
}

enum TranslationStateStatus {
  EMPTY_SOURCE
  MISSING
  TRANSLATED
  OUTDATED
}

enum TranslationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum TranslationJobOrigin {
  MANUAL
  SHOPIFY_CHANGE
}

enum TranslationJobItemStatus {
  PENDING
  GENERATING
  GENERATED
  VALIDATED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  FAILED
}

enum TranslationUsageStage {
  TRANSLATION
  AI_REVIEW
}

enum GlossaryRuleType {
  DO_NOT_TRANSLATE
  PREFERRED_TRANSLATION
  FORBIDDEN_TRANSLATION
}

enum TranslationChangeEventAction {
  UPSERT
  DELETE
}

enum TranslationChangeEventStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Shop {
  id String @id @default(cuid())

  shopifyDomain String  @unique
  shopifyShopId String? @unique

  name String?

  status ShopStatus @default(ACTIVE)

  sourceLocale String?

  currencyCode String?
  ianaTimezone String?

  primaryDomainHost String?
  primaryDomainUrl  String?

  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        ShopSettings?
  aiConfiguration AiConfiguration?

  languages ShopLanguage[]
  markets   ShopMarket[]

  translationResources    TranslationResource[]
  translationJobs         TranslationJob[]
  translationUsageEvents  TranslationUsageEvent[]
  translationChangeEvents TranslationChangeEvent[]
  glossaries              Glossary[]

  @@index([status])
}

model ShopSettings {
  id String @id @default(cuid())

  shopId String @unique

  autoTranslate      Boolean @default(false)
  autoPublish        Boolean @default(false)
  requireHumanReview Boolean @default(true)
  enableAiReview     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model AiConfiguration {
  id String @id @default(cuid())

  shopId String @unique

  translationProvider TranslationProvider @default(OPENAI)
  translationModel    String?

  reviewProvider AiProvider @default(OPENAI)
  reviewModel    String?

  fallbackProvider TranslationProvider @default(OPENAI)
  fallbackModel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Language {
  id String @id @default(cuid())

  locale String @unique
  name   String

  shops ShopLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopLanguage {
  id String @id @default(cuid())

  shopId     String
  languageId String

  primary   Boolean @default(false)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([shopId, languageId])
  @@index([shopId])
  @@index([languageId])
}

model ShopMarket {
  id String @id @default(cuid())

  shopId String

  shopifyMarketId String

  name   String
  handle String

  status String
  type   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyMarketId])
  @@unique([shopId, handle])
  @@index([shopId])
  @@index([status])
}

model TranslationResource {
  id String @id @default(cuid())

  shopId String

  shopifyResourceId String
  resourceType      String

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  fields TranslationField[]

  @@unique([shopId, resourceType, shopifyResourceId])
  @@index([shopId, resourceType])
  @@index([shopId, resourceType, deletedAt])
}

model TranslationField {
  id String @id @default(cuid())

  resourceId String

  key  String
  type String

  sourceLocale String
  sourceValue  String @db.Text
  sourceDigest String

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource TranslationResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  states   TranslationState[]
  jobItems TranslationJobItem[]

  @@unique([resourceId, key])
  @@index([resourceId])
  @@index([resourceId, deletedAt])
}

model TranslationState {
  id String @id @default(cuid())

  fieldId String

  targetLocale String

  status TranslationStateStatus

  translatedValue      String?   @db.Text
  translationUpdatedAt DateTime?

  scannedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field TranslationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, targetLocale])
  @@index([targetLocale, status])
}

model TranslationJob {
  id String @id @default(cuid())

  shopId String

  sourceLocale String
  targetLocale String

  status TranslationJobStatus @default(QUEUED)
  origin TranslationJobOrigin @default(MANUAL)

  /**
   * Stable idempotency key used by automatic Shopify-change jobs.
   * Manual jobs leave this null. PostgreSQL allows multiple null values
   * under a unique constraint, while automatic jobs remain race-safe.
   */
  automationKey String? @unique

  /**
   * Shopify change event that caused this automatic job.
   * Null for manually-created jobs.
   */
  changeEventId String?

  provider TranslationProvider?
  model    String?

  fallbackProvider TranslationProvider?
  fallbackModel    String?

  reviewProvider AiProvider?
  reviewModel    String?

  totalItems     Int @default(0)
  completedItems Int @default(0)
  failedItems    Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  changeEvent TranslationChangeEvent? @relation(fields: [changeEventId], references: [id], onDelete: SetNull)

  items       TranslationJobItem[]
  usageEvents TranslationUsageEvent[]

  @@index([shopId, status])
  @@index([shopId, targetLocale])
  @@index([shopId, origin, createdAt])
  @@index([changeEventId])
  @@index([createdAt])
}

model TranslationJobItem {
  id String @id @default(cuid())

  jobId   String
  fieldId String

  fallbackUsed        Boolean @default(false)
  primaryErrorMessage String? @db.Text

  sourceDigest String
  sourceValue  String @db.Text

  translatedValue String? @db.Text

  status TranslationJobItemStatus @default(PENDING)

  provider TranslationProvider?
  model    String?

  generatedAt DateTime?
  validatedAt DateTime?

  validationPassed Boolean?

  validationErrors   Int @default(0)
  validationWarnings Int @default(0)

  validationIssues Json?

  validationVersion String?

  approvedAt    DateTime?
  approvedValue String?   @db.Text

  humanReviewedAt DateTime?
  humanReviewNote String?   @db.Text

  publishedAt DateTime?

  aiReviewedAt DateTime?

  aiReviewPassed Boolean?
  aiReviewScore  Int?

  aiReviewIssues Json?

  aiReviewSuggestedTranslation String? @db.Text
  aiReviewErrorMessage         String? @db.Text

  aiReviewProvider AiProvider?
  aiReviewModel    String?

  /**
   * Regeneration audit chain.
   * A regenerated translation is a NEW
   * job item. The previous item is never
   * overwritten.
   */
  regeneratedFromItemId String?

  regeneratedFromItem TranslationJobItem?  @relation("TranslationItemRegeneration", fields: [regeneratedFromItemId], references: [id], onDelete: SetNull)
  regeneratedItems    TranslationJobItem[] @relation("TranslationItemRegeneration")

  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job TranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  field TranslationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  usageEvents TranslationUsageEvent[]

  @@unique([jobId, fieldId])
  @@index([jobId, status])
  @@index([fieldId])
  @@index([regeneratedFromItemId])
}

model TranslationUsageEvent {
  id String @id @default(cuid())

  shopId String
  jobId  String?
  itemId String?

  stage TranslationUsageStage

  provider String
  model    String?

  success    Boolean @default(true)
  fallback   Boolean @default(false)
  usageKnown Boolean @default(true)

  billedCharacters Int @default(0)
  inputTokens      Int @default(0)
  outputTokens     Int @default(0)

  /**
   * Estimated cost in millionths of a USD.
   * Example:
   * 1_000_000 microusd = 1 USD.
   * Null means no matching pricing rule was
   * configured when the usage event was written.
   */
  estimatedCostMicrousd Int?

  pricingKey     String?
  pricingVersion String?

  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  job TranslationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  item TranslationJobItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([jobId, createdAt])
  @@index([itemId, createdAt])
  @@index([provider, createdAt])
  @@index([stage, createdAt])
}

model TranslationChangeEvent {
  id String @id @default(cuid())

  shopId String

  webhookId String
  topic     String

  resourceType      String
  shopifyResourceId String

  action TranslationChangeEventAction
  status TranslationChangeEventStatus @default(PROCESSING)

  attempts Int @default(1)

  triggeredAt DateTime?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  translationJobs TranslationJob[]

  @@unique([shopId, webhookId])
  @@index([shopId, status, createdAt])
  @@index([shopId, resourceType, shopifyResourceId, createdAt])
}

model Glossary {
  id String @id @default(cuid())

  shopId String

  name        String
  description String? @db.Text

  sourceLocale String

  enabled   Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  entries GlossaryEntry[]

  @@unique([shopId, name])
  @@index([shopId, enabled])
  @@index([shopId, isDefault])
}

model GlossaryEntry {
  id String @id @default(cuid())

  glossaryId String

  sourceTerm String

  /**
   * "*" means the rule applies to every
   * target locale. Otherwise this contains
   * a normalized locale such as it, de, ja.
   */
  targetLocale String @default("*")

  targetTerm String? @db.Text

  ruleType GlossaryRuleType

  caseSensitive Boolean @default(false)
  enabled       Boolean @default(true)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  glossary Glossary @relation(fields: [glossaryId], references: [id], onDelete: Cascade)

  @@unique([glossaryId, sourceTerm, targetLocale, ruleType])
  @@index([glossaryId, enabled])
  @@index([targetLocale, ruleType])
  @@index([sourceTerm])
}
