{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Checks whether the ACA Locale backend is running.",
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Backend is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "service": "aca-locale-backend",
                    "version": "0.1.0",
                    "environment": "development",
                    "timestamp": "2026-10-03T21:00:00.000Z"
                  }
                }
              }
            }
          }
        },
        "summary": "Backend health check",
        "tags": [
          "System"
        ]
      }
    },
    "/api/v1/shops/current": {
      "get": {
        "operationId": "ShopsController_getCurrentShop",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns the tenant identified by the Shopify ID token."
          },
          "401": {
            "description": "Shopify ID token is missing, invalid or expired."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current authenticated shop",
        "tags": [
          "Shops"
        ]
      }
    },
    "/api/v1/demo/ping": {
      "get": {
        "description": "Development endpoint used to verify Swagger, OpenAPI and API connectivity.",
        "operationId": "DemoController_ping",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Demo API is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "message": "ACA Locale demo API is reachable.",
                    "timestamp": "2026-10-03T21:00:00.000Z"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Demo endpoints are disabled."
          }
        },
        "summary": "Demo API ping",
        "tags": [
          "Demo"
        ]
      }
    },
    "/api/v1/demo/bootstrap-shop": {
      "post": {
        "description": "Creates or updates the ACA Locale development Shopify store together with its default settings and AI configuration. Development/demo only.",
        "operationId": "DemoController_bootstrapShop",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Development shop successfully bootstrapped."
          },
          "404": {
            "description": "Demo endpoints are disabled."
          }
        },
        "summary": "Bootstrap ACA Locale development shop",
        "tags": [
          "Demo"
        ]
      }
    },
    "/api/v1/demo/shops": {
      "get": {
        "operationId": "DemoController_listShops",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns all registered shops. Development/demo only."
          }
        },
        "summary": "List all demo shops",
        "tags": [
          "Demo"
        ]
      }
    },
    "/api/v1/languages": {
      "get": {
        "operationId": "LanguagesController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Shop languages returned successfully."
          },
          "401": {
            "description": "Shopify ID token is missing or invalid."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List languages for the authenticated shop",
        "tags": [
          "Languages"
        ]
      }
    },
    "/api/v1/languages/sync/shopify": {
      "post": {
        "description": "Synchronizes Shopify locales with ACA Locale and updates the shop source locale from the Shopify primary locale.",
        "operationId": "LanguagesController_syncShopify",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncShopifyLocalesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shopify locales synchronized successfully."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Synchronize Shopify locales",
        "tags": [
          "Languages"
        ]
      }
    },
    "/api/v1/markets": {
      "get": {
        "operationId": "MarketsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Shop markets returned successfully."
          },
          "401": {
            "description": "Shopify ID token is missing or invalid."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List markets for the authenticated shop",
        "tags": [
          "Markets"
        ]
      }
    },
    "/api/v1/markets/sync/shopify": {
      "post": {
        "operationId": "MarketsController_syncShopify",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncShopifyMarketsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shopify Markets synchronized successfully."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Synchronize Shopify Markets",
        "tags": [
          "Markets"
        ]
      }
    },
    "/api/v1/shopify/configuration/sync": {
      "post": {
        "description": "Synchronizes the authenticated Shopify store identity, locales and markets with ACA Locale.",
        "operationId": "ShopifySyncController_sync",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncShopifyConfigurationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shopify configuration synchronized successfully."
          },
          "401": {
            "description": "Shopify ID token is missing, invalid or expired."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Synchronize Shopify configuration",
        "tags": [
          "Shopify Configuration"
        ]
      }
    }
  },
  "info": {
    "title": "ACA Locale API",
    "description": "Technical API documentation for ACA Locale.\n\nACA Locale is an AI-powered localization management platform.\n\nThis specification is generated automatically from the NestJS backend.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SyncShopifyLocalesDto": {
        "type": "object",
        "properties": {}
      },
      "SyncShopifyMarketsDto": {
        "type": "object",
        "properties": {}
      },
      "ShopifyPrimaryDomainDto": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "example": "aca-locale-dev-cfoxunuo.myshopify.com"
          },
          "url": {
            "type": "string",
            "example": "https://aca-locale-dev-cfoxunuo.myshopify.com"
          }
        },
        "required": [
          "host",
          "url"
        ]
      },
      "ShopifyShopIdentityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "gid://shopify/Shop/78982250633"
          },
          "name": {
            "type": "string",
            "example": "ACA Locale Dev"
          },
          "currencyCode": {
            "type": "string",
            "example": "USD"
          },
          "ianaTimezone": {
            "type": "string",
            "example": "America/New_York"
          },
          "primaryDomain": {
            "$ref": "#/components/schemas/ShopifyPrimaryDomainDto"
          }
        },
        "required": [
          "id",
          "name",
          "currencyCode",
          "ianaTimezone",
          "primaryDomain"
        ]
      },
      "ShopifyLocaleDto": {
        "type": "object",
        "properties": {}
      },
      "ShopifyMarketDto": {
        "type": "object",
        "properties": {}
      },
      "SyncShopifyConfigurationDto": {
        "type": "object",
        "properties": {
          "shop": {
            "$ref": "#/components/schemas/ShopifyShopIdentityDto"
          },
          "locales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopifyLocaleDto"
            }
          },
          "markets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopifyMarketDto"
            }
          }
        },
        "required": [
          "shop",
          "locales",
          "markets"
        ]
      }
    }
  }
}